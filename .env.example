# Copy to .env and fill in. `.env` is git-ignored; never commit the real file.
#
# The key is read from the environment, not from a CLI flag, because run.py
# persists `vars(args)` into the `runs` table -- a flag would write the
# credential into pipeline.db. An already-set environment variable wins over
# this file, so `SERPER_API_KEY=... python3 run.py ...` still overrides it.

# Serper, the Phase 2 Stage 2 search vendor -- https://serper.dev
# Only used when --search-provider serper is passed; nothing spends otherwise.
SERPER_API_KEY=
